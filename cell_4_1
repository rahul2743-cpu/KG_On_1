def clean_xwiki_text(raw_text: str) -> str:
    """
    Cleans XWiki 2.1 markup to readable text.
    Doc links become single-bracketed reference chips:
        [[Label>>doc:Ref]]  -> [Label <doc:Ref>]
        [[doc:Ref]]         -> [<doc:Ref>]
    """
    if not raw_text:
        return ""
    text = raw_text

    text = re.sub(r"<!\[CDATA\[|\]\]>", "", text)
    text = re.sub(r"<(?!doc:)[^>]+>", " ", text)

    text = re.sub(r"\[\[~\[~\[image:.*?attach:[^\]]*\]\]", "", text, flags=re.DOTALL)
    text = re.sub(r"\[\[\s*image:.*?\]\]", "", text, flags=re.DOTALL)
    text = re.sub(r"\[\[\s*file:.*?\]\]",  "", text, flags=re.DOTALL)
    text = re.sub(r"attach:\S+", "", text)

    def _labelled_link(m):
        label = m.group("label").strip()
        wiki  = m.group("wiki")
        ref   = m.group("ref").strip()
        tag   = f"<doc:wiki:{ref}>" if wiki else f"<doc:{ref}>"
        return f"[{label} {tag}]" if label else f"[{tag}]"

    text = re.sub(
        r"\[\[\s*(?P<label>[^\[\]>]*?)>>\s*doc:(?P<wiki>wiki:)?(?P<ref>[^\]\|]+?)(?:\|\|[^\]]*)?\]\]",
        _labelled_link, text,
    )
    text = re.sub(
        r"\[\[\s*doc:(wiki:)?([^\]\|]+?)(?:\|\|[^\]]*)?\]\]",
        lambda m: f"[<doc:wiki:{m.group(2).strip()}>]" if m.group(1) else f"[<doc:{m.group(2).strip()}>]",
        text,
    )
    text = re.sub(r"\[\[\s*(?P<label>[^\[\]>]*?)>>[^\]]+\]\]", lambda m: m.group("label").strip(), text)
    text = re.sub(r"\[\[\s*(?P<label>[^\[\]]+?)\]\]", lambda m: m.group("label").strip(), text)

    text = re.sub(r"\{\{\{(.*?)\}\}\}", r"\1", text, flags=re.DOTALL)
    text = re.sub(r"\{\{.*?\}\}", "", text, flags=re.DOTALL)
    text = re.sub(r"\(%.*?%\)", "", text)
    text = re.sub(r"\(\(\(|\)\)\)", "", text)
    text = re.sub(r"={2,}\s*(.*?)\s*={2,}", r"\n\1\n", text)
    text = re.sub(r"^-{3,}$", "", text, flags=re.MULTILINE)

    text = re.sub(r"\*\*|__|~~|##", "", text)
    text = re.sub(r"(?<!:)//", "", text)

    text = re.sub(r"~[\[\]|]", "", text)
    text = re.sub(r"\(\s*\)", "", text)
    text = re.sub(r"\|=", "|", text)

    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    text = re.sub(r"[ \t]+\n", "\n", text)
    return text.strip()


