def clean_xwiki_text(raw_text: str) -> str:
    """
    Cleans XWiki 2.1 markup to readable text — generic across all
    exports from this wiki.

    Doc links resolve to "Label <doc:Ref>" or "<doc:Ref>" (never dropped).
    Tables (including the export-control footer) are KEPT as readable
    text — only the '=' header-cell marker is stripped, '|' is kept.
    """
    if not raw_text:
        return ""
    text = raw_text

    # 1. CDATA
    text = re.sub(r"<!\[CDATA\[|\]\]>", "", text)
    # 2. Strip real HTML/XML tags only — never touch our own <doc:...> markers
    text = re.sub(r"<(?!doc:)[^>]+>", " ", text)

    # 3. Escaped-bracket thumbnail image wrapper -> drop entirely
    text = re.sub(r"\[\[~\[~\[image:.*?attach:[^\]]*\]\]", "", text, flags=re.DOTALL)

    # 4. Plain image/file/attach macros -> drop entirely
    text = re.sub(r"\[\[\s*image:.*?\]\]", "", text, flags=re.DOTALL)
    text = re.sub(r"\[\[\s*file:.*?\]\]",  "", text, flags=re.DOTALL)
    text = re.sub(r"attach:\S+", "", text)

    # 5. [[Label>>doc:Ref]] / [[Label>>doc:wiki:Ref]] -> "Label <doc:Ref>"
    def _labelled_link(m):
        label = m.group("label").strip()
        wiki  = m.group("wiki")
        ref   = m.group("ref").strip()
        tag   = f"<doc:wiki:{ref}>" if wiki else f"<doc:{ref}>"
        return f"{label} {tag}" if label else tag

    text = re.sub(
        r"\[\[\s*(?P<label>[^\[\]>]*?)>>\s*doc:(?P<wiki>wiki:)?(?P<ref>[^\]\|]+?)(?:\|\|[^\]]*)?\]\]",
        _labelled_link, text,
    )

    # 6. Bare [[doc:Ref]] / [[doc:wiki:Ref]] -> <doc:Ref> / <doc:wiki:Ref>
    text = re.sub(
        r"\[\[\s*doc:(wiki:)?([^\]\|]+?)(?:\|\|[^\]]*)?\]\]",
        lambda m: f"<doc:wiki:{m.group(2).strip()}>" if m.group(1) else f"<doc:{m.group(2).strip()}>",
        text,
    )

    # 7. Non-doc wiki links -> keep label text only
    text = re.sub(r"\[\[\s*(?P<label>[^\[\]>]*?)>>[^\]]+\]\]", lambda m: m.group("label").strip(), text)
    text = re.sub(r"\[\[\s*(?P<label>[^\[\]]+?)\]\]", lambda m: m.group("label").strip(), text)

    # 8a. Triple-brace {{{...}}} = verbatim TEXT -> keep content, drop braces only
    text = re.sub(r"\{\{\{(.*?)\}\}\}", r"\1", text, flags=re.DOTALL)
    # 8b. Double-brace macros -> remove entirely
    text = re.sub(r"\{\{.*?\}\}", "", text, flags=re.DOTALL)

    # 9. (% class="x" %) style macros
    text = re.sub(r"\(%.*?%\)", "", text)
    # 10. ((( ))) container markers -> remove markers only, keep inner text
    text = re.sub(r"\(\(\(|\)\)\)", "", text)

    # 11. Headings: == Heading == -> Heading (own line)
    text = re.sub(r"={2,}\s*(.*?)\s*={2,}", r"\n\1\n", text)
    # 12. Horizontal rules
    text = re.sub(r"^-{3,}$", "", text, flags=re.MULTILINE)

    # 13. Bold/underline/strike/monospace — safe to strip anywhere
    text = re.sub(r"\*\*|__|~~|##", "", text)
    # 14. Italic "//" — but NOT part of a URL scheme like https://
    text = re.sub(r"(?<!:)//", "", text)

    # 15. Leftover escape markers ~[ ~] ~|
    text = re.sub(r"~[\[\]|]", "", text)
    # 16. Empty parens left behind by macro removal
    text = re.sub(r"\(\s*\)", "", text)

    # 17. Tables (including export-control footer): KEEP as readable text.
    #     Only strip the leading '=' marking a header cell, e.g. '|=Jurisdiction' -> '|Jurisdiction'
    text = re.sub(r"\|=", "|", text)

    # 18. Whitespace normalize
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    text = re.sub(r"[ \t]+\n", "\n", text)

    return text.strip()
