# ==========================================================
# Cell 4 : Extract Matching XML Documents
# ==========================================================

from pyspark.sql import functions as F
from pyspark.sql.window import Window

# ----------------------------------------------------------
# Read Raw XML Table
# ----------------------------------------------------------

RAW_TABLE = "knwbt_airr_foundry_dev_catalog.secured.knowbot_raw_data"

raw_df = spark.table(RAW_TABLE)

print("=" * 80)
print("KNOWBOT RAW DATA")
print("=" * 80)

print(f"Total XML Documents : {raw_df.count()}")

# ----------------------------------------------------------
# Match XML Paths
# raw_df already has its own doc_id -> that is the authoritative one.
# Only bring "source" from top50_sources to join on; drop its doc_id.
# ----------------------------------------------------------

matched_xml = (

    raw_df.alias("raw")

    .join(

        top50_sources.select(
            F.col("source").alias("eval_source")
        ).alias("eval"),

        F.col("raw.source") == F.col("eval.eval_source"),

        "inner"

    )

)

# ----------------------------------------------------------
# Keep Only the LATEST Version per doc_id (raw's doc_id)
# ----------------------------------------------------------

version_window = Window.partitionBy("raw.doc_id").orderBy(
    F.col("content_update_date").desc()
)

matched_xml = (

    matched_xml

    .withColumn("rn", F.row_number().over(version_window))

    .filter(F.col("rn") == 1)

    .drop("rn")

)

# ----------------------------------------------------------
# Select Required Columns
# ----------------------------------------------------------

matched_xml = (

    matched_xml

    .select(

        F.col("raw.doc_id").alias("doc_id"),
        "title",
        "content",
        "reference",
        F.col("raw.source").alias("source"),
        "version",
        "content_update_date",
        "content_author"

    )

).cache()

# ----------------------------------------------------------
# Add a Clean Sequential Index for Display : 0, 1, 2, 3 ...
# (original doc_id is kept too — it's the real key, needed later
#  to rejoin knowbot_raw_data or trace a graph node back to source)
# ----------------------------------------------------------

seq_window = Window.orderBy("doc_id")

matched_xml = (

    matched_xml

    .withColumn("seq_id", F.row_number().over(seq_window) - 1)

    .select(
        "seq_id",
        "doc_id",
        "title",
        "content",
        "reference",
        "source",
        "version",
        "content_update_date",
        "content_author"
    )

).cache()

n_matched = matched_xml.count()

# ----------------------------------------------------------
# Diagnostics — where did documents get lost?
# ----------------------------------------------------------

n_seed = top50_sources.count()

print()
print("=" * 80)
print("MATCHED XML DOCUMENTS")
print("=" * 80)

print(f"Seed documents (cell 3) : {n_seed}")
print(f"Matched XML documents   : {n_matched}")

if n_matched < n_seed:
    missing = (
        top50_sources
        .select(F.col("source").alias("eval_source"))
        .join(
            matched_xml.select("source"),
            top50_sources["source"] == matched_xml["source"],
            how="left_anti"
        )
    )
    print(f"⚠️  {n_seed - n_matched} seed doc(s) NOT found in {RAW_TABLE}:")
    display(missing)

print()
display(matched_xml)
