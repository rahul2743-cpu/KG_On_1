import textwrap

WRAP_WIDTH = 90


def _wrap(text, width=WRAP_WIDTH, indent=""):
    """Wraps each line separately so blank lines (paragraph breaks) and
    short standalone lines like commands are preserved, rather than
    collapsed into one block by a plain textwrap.fill()."""
    out = []
    for line in (text or "").splitlines():
        if not line.strip():
            out.append("")                     # keep paragraph break
        else:
            out.extend(textwrap.wrap(
                line, width=width,
                initial_indent=indent, subsequent_indent=indent,
                break_long_words=False,        # don't split MTCCM.Run_OpenTCCM
                break_on_hyphens=False,
            ))
    return "\n".join(out)


