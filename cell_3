# ==========================================================
# Cell 3 : Read Evaluation Dataset  →  Seed Document Set
# ==========================================================

from pyspark.sql import functions as F
from pyspark.sql.window import Window

# ----------------------------------------------------------
# Configuration
# ----------------------------------------------------------

RAG_EVAL_TABLE = "knwbt_airr_foundry_dev_catalog.secured.rag_eval_set"

# Number of XML DOCUMENTS to load (not questions)
TOP_K_XML = 50

# Output Delta table for the seed document set
SEED_DOCS_TABLE = "knwbt_airr_foundry_dev_catalog.secured.kg_seed_docs"

# ----------------------------------------------------------
# Read Evaluation Dataset
# ----------------------------------------------------------

rag_eval_df = spark.table(RAG_EVAL_TABLE).cache()

print("=" * 80)
print("RAG EVALUATION DATASET")
print("=" * 80)
print(f"Total Questions : {rag_eval_df.count()}")

# ----------------------------------------------------------
# Unique XML Documents — dedupe FIRST, then assign doc_id, then limit
# ----------------------------------------------------------

all_docs = (

    rag_eval_df

    .select(
        "source",
        "source_doc_title",
        "source_doc_ref",
        "retrieved_context"
    )

    .dropDuplicates(["source"])

    .orderBy("source")

)

doc_window = Window.orderBy("source")

all_docs = (

    all_docs

    .withColumn("doc_id", F.row_number().over(doc_window))

    .select(
        "doc_id",
        "source",
        "source_doc_title",
        "source_doc_ref",
        "retrieved_context"
    )

)

top50_sources = (

    all_docs.filter(F.col("doc_id") <= TOP_K_XML)
    if TOP_K_XML
    else all_docs

).cache()

# ----------------------------------------------------------
# Questions Belonging to the Selected Documents
# ----------------------------------------------------------

top50_eval = (

    rag_eval_df

    .join(
        top50_sources.select("source"),
        on  = "source",
        how = "inner"
    )

).cache()

# ----------------------------------------------------------
# Write Seed Docs as a Delta Table
# ----------------------------------------------------------

(
    top50_sources
    .write
    .mode("overwrite")
    .option("overwriteSchema", "true")
    .saveAsTable(SEED_DOCS_TABLE)
)

# ----------------------------------------------------------
# Summary
# ----------------------------------------------------------

print()
print("=" * 80)
print("TOP XML SOURCES")
print("=" * 80)

print(f"Questions Selected : {top50_eval.count()}")
print(f"Unique XML Sources : {top50_sources.count()}")
print(f"Table Created      : {SEED_DOCS_TABLE}")

print()
display(top50_sources)

print()
display(top50_eval)
