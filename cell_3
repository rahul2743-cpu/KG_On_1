# Cell 3 : Read Evaluation Dataset 
# ==========================================================

from pyspark.sql import functions as F
from pyspark.sql.window import Window

# ----------------------------------------------------------
# Configuration
# ----------------------------------------------------------

RAG_EVAL_TABLE = "knwbt_airr_foundry_dev_catalog.secured.rag_eval_set"

TOP_K_XML = 50

# ----------------------------------------------------------
# Read Evaluation Dataset
# ----------------------------------------------------------

rag_eval_df = (

    spark.table(RAG_EVAL_TABLE)

    .select(
        "source",
        "request",
        "response",
        "difficulty",
        "ground_truth"
    )

)

print("=" * 80)
print("RAG EVALUATION DATASET")
print("=" * 80)

print(f"Total Questions : {rag_eval_df.count()}")

# ----------------------------------------------------------
# Unique XML Documents  → assign doc_id starting at 1
# ----------------------------------------------------------

doc_window = Window.orderBy("source")

unique_docs = (

    rag_eval_df

    .select("source")

    .dropDuplicates(["source"])

    .withColumn("doc_id", F.row_number().over(doc_window))

    .orderBy("doc_id")

)

# ----------------------------------------------------------
# Take Top 50 XML Sources
# ----------------------------------------------------------

top50_sources = (

    unique_docs

    .filter(F.col("doc_id") <= TOP_K_XML)

)

# ----------------------------------------------------------
# Questions Belonging to the Selected 50 Documents
# ----------------------------------------------------------

top50_eval = (

    rag_eval_df

    .join(
        top50_sources,
        on  = "source",
        how = "inner"
    )

)

print()

print("=" * 80)
print("TOP XML SOURCES")
print("=" * 80)

print(f"Questions Selected : {top50_eval.count()}")

print(f"Unique XML Sources : {top50_sources.count()}")

print()

display(top50_eval)

print()

display(top50_sources)
