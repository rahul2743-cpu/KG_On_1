# ----------------------------------------------------------
# 3. NOUN-PHRASE FREQUENCY
#    Network-restricted workspaces can't reach spaCy's model
#    download host — this step degrades gracefully instead of
#    crashing the cell, and suppresses the noisy SSL traceback.
# ----------------------------------------------------------
try:
    import spacy
    try:
        nlp = spacy.load("en_core_web_sm", disable=["ner", "lemmatizer"])
    except OSError:
        import subprocess
        result = subprocess.run(
            ["python", "-m", "spacy", "download", "en_core_web_sm"],
            capture_output=True, text=True, timeout=30,
        )
        if result.returncode != 0:
            raise RuntimeError("Model download blocked (no network egress to spaCy host)")
        nlp = spacy.load("en_core_web_sm", disable=["ner", "lemmatizer"])

    texts = [
        row["node_content"]
        for row in knowledge_nodes.select("node_content").collect()
        if row["node_content"]
    ]

    phrase_counts = Counter()
    STOPISH = {"this", "that", "these", "those", "it", "which", "who", "what"}

    for doc in nlp.pipe(texts, batch_size=32):
        for chunk in doc.noun_chunks:
            phrase = re.sub(r"\s+", " ", chunk.text.strip().lower())
            if len(phrase) < 3 or phrase in STOPISH:
                continue
            phrase_counts[phrase] += 1

    print()
    print("─" * 80)
    print("TOP RECURRING NOUN PHRASES")
    print("─" * 80)
    for phrase, n in phrase_counts.most_common(50):
        print(f"  {n:4d}  {phrase}")

except Exception as e:
    print()
    print(f"⚠️  spaCy step skipped ({e}).")
    print("    Tags + hub documents above are sufficient evidence to name")
    print("    the ontology — this step only adds untagged vocabulary.")

