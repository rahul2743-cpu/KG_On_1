from pyspark.sql import functions as F
from collections import Counter
import re

print("=" * 80)
print("CORPUS PROFILING")
print("=" * 80)
print(f"Documents in scope : {knowledge_nodes.count()}")

# ----------------------------------------------------------
# 1. TAG FREQUENCY
#    Tags are XWiki.TagClass <value> entries inside content_raw.
#    Extracted generically via regex — no assumption about
#    which tags exist, just where tags live structurally.
# ----------------------------------------------------------
TAG_PATTERN = r"<className>XWiki\.TagClass</className>.*?<value>(.*?)</value>"

tag_df = (
    xml_df
    .select("doc_id", "content_raw")
    .withColumn("_tags", F.expr(
        f"regexp_extract_all(content_raw, '{TAG_PATTERN}', 1)"
    ))
    .withColumn("tag", F.explode_outer("_tags"))
    .filter(F.col("tag").isNotNull() & (F.col("tag") != ""))
)

tag_counts = (
    tag_df
    .groupBy("tag")
    .count()
    .orderBy(F.desc("count"))
)

n_tagged_docs = tag_df.select("doc_id").distinct().count()
n_total_docs  = knowledge_nodes.count()

print()
print("─" * 80)
print(f"TAGS  ({n_tagged_docs}/{n_total_docs} documents carry at least one tag)")
print("─" * 80)
display(tag_counts.limit(40))

# ----------------------------------------------------------
# 2. HUB DOCUMENTS
#    Most-referenced targets from Cell 7's hyperlink extraction —
