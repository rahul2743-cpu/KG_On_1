# ----------------------------------------------------------
# 1. TAG FREQUENCY
#    (?s) = inline DOTALL — needed because <className> and <value>
#    sit on different lines in your real XML; without it "." never
#    crosses a newline and the regex silently matches nothing.
#    Called as a NATIVE column function — NOT F.expr("...") — since
#    F.expr() re-escapes backslashes in the SQL string layer and
#    corrupts "\." before the regex engine ever sees it (same bug
#    we hit and fixed in Cell 7).
# ----------------------------------------------------------
TAG_PATTERN = r"(?s)<className>XWiki\.TagClass</className>.*?<value>(.*?)</value>"

tag_df = (
    xml_df
    .select("doc_id", "content_raw")
    .withColumn("_tags", F.regexp_extract_all(F.col("content_raw"), F.lit(TAG_PATTERN), 1))
    .withColumn("tag", F.explode_outer("_tags"))
    .filter(F.col("tag").isNotNull() & (F.col("tag") != ""))
)

tag_counts = (
    tag_df
    .groupBy("tag")
    .count()
    .orderBy(F.desc("count"))
)

n_tagged_docs = tag_df.select("doc_id").distinct().count()
n_total_docs  = knowledge_nodes.count()

print()
print("─" * 80)
print(f"TAGS  ({n_tagged_docs}/{n_total_docs} documents carry at least one tag)")
print("─" * 80)
display(tag_counts.limit(40))

