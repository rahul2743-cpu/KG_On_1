# ----------------------------------------------------------
# 1. TAG FREQUENCY — read directly from source XML files
#    (?s) = inline DOTALL, since <className> and <value> sit on
#    different lines in the raw XML.
# ----------------------------------------------------------
TAG_PATTERN = re.compile(r"(?s)<className>XWiki\.TagClass</className>.*?<value>(.*?)</value>")

def extract_tags_from_file(path):
    if not path:
        return []
    try:
        # Databricks Volume/DBFS paths sometimes need the /dbfs prefix
        # for plain Python file I/O (not needed for dbfs:/... via Spark,
        # but IS needed for open() in a UDF running on the executor).
        local_path = path
        if local_path.startswith("dbfs:/"):
            local_path = "/dbfs/" + local_path[len("dbfs:/"):]
        with open(local_path, "r", encoding="utf-8", errors="ignore") as f:
            text = f.read()
        return TAG_PATTERN.findall(text)
    except Exception:
        return []   # unreadable file -> no tags, not a crash

extract_tags_udf = F.udf(extract_tags_from_file, ArrayType(StringType()))

tag_df = (
    knowledge_nodes
    .select("doc_id", "source")
    .withColumn("_tags", extract_tags_udf(F.col("source")))
    .withColumn("tag", F.explode_outer("_tags"))
    .filter(F.col("tag").isNotNull() & (F.col("tag") != ""))
)

tag_counts = (
    tag_df
    .groupBy("tag")
    .count()
    .orderBy(F.desc("count"))
)

n_tagged_docs = tag_df.select("doc_id").distinct().count()
n_total_docs  = knowledge_nodes.count()

print()
print("─" * 80)
print(f"TAGS  ({n_tagged_docs}/{n_total_docs} documents carry at least one tag)")
print("─" * 80)
display(tag_counts.limit(40))

