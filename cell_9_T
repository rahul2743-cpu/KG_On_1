print("─" * 80)
display(hub_docs.limit(30))

# ----------------------------------------------------------
# 3. NOUN-PHRASE FREQUENCY
#    Generic NLP statistics over node_content — no domain
#    assumptions, just "what nouns/phrases recur across the corpus".
#    Small model, noun_chunks only — fast enough for 200-500 docs.
# ----------------------------------------------------------
try:
    import spacy
    try:
        nlp = spacy.load("en_core_web_sm", disable=["ner", "lemmatizer"])
    except OSError:
        import subprocess
        subprocess.run(["python", "-m", "spacy", "download", "en_core_web_sm"], check=True)
        nlp = spacy.load("en_core_web_sm", disable=["ner", "lemmatizer"])

    texts = [
        row["node_content"]
        for row in knowledge_nodes.select("node_content").collect()
        if row["node_content"]
    ]

    phrase_counts = Counter()
    STOPISH = {"this", "that", "these", "those", "it", "which", "who", "what"}

    for doc in nlp.pipe(texts, batch_size=32):
        for chunk in doc.noun_chunks:
            phrase = re.sub(r"\s+", " ", chunk.text.strip().lower())
            if len(phrase) < 3 or phrase in STOPISH:
                continue
            phrase_counts[phrase] += 1

    print()
    print("─" * 80)
    print("TOP RECURRING NOUN PHRASES (generic NLP, no domain assumptions)")
    print("─" * 80)
    for phrase, n in phrase_counts.most_common(50):
        print(f"  {n:4d}  {phrase}")

except Exception as e:
    print()
    print(f"⚠️  spaCy step skipped ({e}). Tags + hub documents above are still usable "
          f"evidence on their own — this step just adds untagged vocabulary.")

