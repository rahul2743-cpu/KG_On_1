# ==========================================================
# Cell 10 : LLM RELATIONSHIP EXTRACTION  (scales 500 -> 20,000+ docs)
#           Rebuilt to be GENERIC and DISTRIBUTED, not a driver-side loop:
#
#           1. mapPartitions -- documents are split across the cluster's
#              executors and processed IN PARALLEL, not one at a time on
#              the driver. Concurrency = N_PARTITIONS, set below.
#           2. CHECKPOINTING -- every completed relationship is written
#              to a Delta table immediately. Re-running this cell SKIPS
#              documents already processed -- a crash or interruption at
#              document 15,000 does not mean starting over from zero.
#           3. PER-DOCUMENT ERROR HANDLING -- one bad document (timeout,
#              malformed response, API hiccup) is logged and skipped,
#              not fatal to the whole 20k-document run.
#           4. Same extraction logic as before (unchanged): full-document
#              context, snake_case predicates, name-matched parsing,
#              unresolved-link sanitization -- only the EXECUTION model
#              changed, not what gets asked of the LLM.
#
#           Needs: sentences_df (Cell 8b), document_rendered_df (Cell 8d)
#           Does NOT need `llm` from Cell 9 -- each executor builds its
#           own client from the broadcast-safe config below (Cell 9's
#           `llm` object itself can't cross to executors).
# ==========================================================
import re
from pyspark.sql import functions as F
from pyspark.sql.types import (
    StructType, StructField, StringType, IntegerType
)

print("=" * 80)
print("CELL 10 — LLM RELATIONSHIP EXTRACTION (distributed)")
print("=" * 80)

# ---- Scale knobs ----------------------------------------------------------
N_PARTITIONS       = 40     # concurrency: how many documents process AT ONCE
                             # across the cluster. Raise toward your LLM
                             # endpoint's rate limit / cluster core count.
MAX_CONTENT_CHARS  = 12000
CHECKPOINT_TABLE   = "knwbt_airr_foundry_dev_catalog.secured.kg_relationship_checkpoint"

# ---- Connection config (plain values, NOT the llm client object) ---------
# Executors can't receive Cell 9's `llm` object directly -- each partition
# builds its own client from these values instead. Same credentials Cell 9
# already resolved.
_CONN = {
    "model": DEPLOYMENT_NAME,
    "base_url": "https://adb-3955688708870984.4.azuredatabricks.net/serving-endpoints",
    "api_key": DATABRICKS_TOKEN,
}

TUPLE_DELIM  = "<|>"
RECORD_DELIM = "##"

SYSTEM_PROMPT = f"""---Role---
You are an AI assistant extracting relationships for a knowledge graph.

---Goal---
You are given ONE FULL DOCUMENT (the SOURCE entity) and a list of TARGET
entities that are already marked inside the document text as <Entity Name>.
Every <...> bracket you see in the document text corresponds to exactly
one of the target entities listed below -- there is no other bracket
usage in this document. The entities are already known -- do NOT invent
new ones, do NOT rename them. Your only job: for EACH target entity
listed, read how it is used across the WHOLE document (it may be
mentioned more than once) and describe its relationship to the source
document.

For each target entity, extract:
- predicate: a short relationship label in snake_case (lowercase words
  joined by underscores, 2-5 words), e.g. "is_subject_to",
  "is_formalised_under", "achieves_combination_with", "is_defined_by",
  "depends_on". NO spaces, NO hyphens -- underscores only.
- description: 1-2 sentences explaining WHY / HOW the source document and
  this entity are related, grounded ONLY in what the document actually says
- strength: an integer 1-10 for how strong/explicit the relationship is
  (10 = central to the document, explicitly and repeatedly stated;
   1 = a passing, incidental mention)

---Output format---
One record per target entity, in the SAME ORDER as the entity list given
to you, formatted EXACTLY as:
<entity name>{TUPLE_DELIM}<predicate>{TUPLE_DELIM}<description>{TUPLE_DELIM}<strength>{RECORD_DELIM}

Example, given target entity "Trent Engine Family":
Trent Engine Family{TUPLE_DELIM}is_subject_to{TUPLE_DELIM}The document defines blocking rules that the Trent Engine Family must follow during endurance testing.{TUPLE_DELIM}8{RECORD_DELIM}

No JSON. No markdown. No preamble or explanation outside the records.
One record per entity listed -- do not skip any, do not add extras."""

_UNRESOLVED_MARKUP_RE = re.compile(r"\[?<doc:(?:wiki:)?[^<>]+>\]?")


def _sanitize_for_llm(text):
    return re.sub(r"\s+", " ", _UNRESOLVED_MARKUP_RE.sub(" ", text)).strip()


def _to_snake_case(s):
    s = s.strip().lower()
    s = re.sub(r"[^a-z0-9]+", "_", s)
    s = re.sub(r"_+", "_", s).strip("_")
    return s or "related_to"


def _parse_records(text, entity_names):
    by_name = {}
    for record in text.split(RECORD_DELIM):
        record = record.strip().strip(",")
        if not record:
            continue
        parts = [p.strip() for p in record.split(TUPLE_DELIM)]
        if len(parts) < 3:
            continue
        name = parts[0].strip().lower()
        predicate = _to_snake_case(parts[1]) if len(parts) > 1 else "related_to"
        description = parts[2] if len(parts) > 2 else ""
        try:
            strength = max(1, min(10, int(re.sub(r"\D", "", parts[3]))))
        except (ValueError, IndexError):
            strength = 5
        by_name[name] = (predicate, description, strength)

    return [
        by_name.get(name.strip().lower(), ("related_to", "", 5))
        for name in entity_names
    ]


# ---- The distributed worker: runs on an executor, once per Arrow batch --
# Rewritten for mapInPandas (RDD-based mapPartitions is NOT allowed on
# serverless compute -- see Databricks error [NOT_IMPLEMENTED]). Same idea
# as before: one LLM client built per batch and reused, one document
# processed at a time, one bad document never kills the whole run.
def process_partition_pandas(pdf_iterator):
    import pandas as pd
    from langchain_openai import ChatOpenAI

    partition_llm = ChatOpenAI(
        model=_CONN["model"], base_url=_CONN["base_url"],
        api_key=_CONN["api_key"], temperature=0,
    )

    out_columns = [
        "source_node", "source_title", "predicate",
        "relationship_description", "relationship_strength",
        "target_title", "target_reference", "link_type",
    ]

    for pdf in pdf_iterator:
        out_rows = []

        for _, row in pdf.iterrows():
            entities = row["entities"]   # list of dict-like structs (target_title/target_reference/link_type)
            entity_names = [e["target_title"] for e in entities]

            try:
                entity_list_str = "\n".join(f"- {n}" for n in entity_names)
                clean_content = _sanitize_for_llm(row["content_with_titles"])
                if len(clean_content) > MAX_CONTENT_CHARS:
                    clean_content = clean_content[:MAX_CONTENT_CHARS] + " ...[truncated]"

                user_prompt = (
                    f"SOURCE document title: {row['source_title']}\n\n"
                    f"Target entities to describe (in this order):\n{entity_list_str}\n\n"
                    f"Document text:\n{clean_content}"
                )

                resp = partition_llm.invoke([
                    {"role": "system", "content": SYSTEM_PROMPT},
                    {"role": "user", "content": user_prompt},
                ])
                results = _parse_records(resp.content.strip(), entity_names)

            except Exception as e:
                # ONE bad document -> log it, fall back to safe defaults for
                # every one of its entities, keep going. Never crash the job.
                results = [("related_to", f"[extraction failed: {e}]", 1) for _ in entities]

            for entity, (predicate, description, strength) in zip(entities, results):
                out_rows.append({
                    "source_node": row["source_node"],
                    "source_title": row["source_title"],
                    "predicate": predicate,
                    "relationship_description": description,
                    "relationship_strength": strength,
                    "target_title": entity["target_title"],
                    "target_reference": entity["target_reference"],
                    "link_type": entity["link_type"],
                })

        # ALWAYS yield a DataFrame with the right columns, even if empty --
        # mapInPandas requires the schema to match on every yielded batch.
        yield pd.DataFrame(out_rows, columns=out_columns)


TRIPLES_SCHEMA = StructType([
    StructField("source_node", StringType()),
    StructField("source_title", StringType()),
    StructField("predicate", StringType()),
    StructField("relationship_description", StringType()),
    StructField("relationship_strength", IntegerType()),
    StructField("target_title", StringType()),
    StructField("target_reference", StringType()),
    StructField("link_type", StringType()),
])

# ---- Step 1: distinct resolved (document -> entity) pairs -----------------
distinct_targets = (
    sentences_df
    .filter(F.col("is_resolved"))
    .select("source_node", "source_title", "target_reference", "target_title", "link_type")
    .distinct()
)

doc_entities = (
    distinct_targets
    .groupBy("source_node", "source_title")
    .agg(F.collect_list(
        F.struct("target_title", "target_reference", "link_type")
    ).alias("entities"))
)

doc_prompt_inputs = (
    doc_entities
    .join(
        document_rendered_df.select("source_node", "content_with_titles"),
        on="source_node", how="inner"
    )
)

# ---- Step 2: skip documents already checkpointed (resumable at scale) ----
try:
    already_done = spark.table(CHECKPOINT_TABLE).select("source_node").distinct()
    n_already_done = already_done.count()
    doc_prompt_inputs = doc_prompt_inputs.join(already_done, on="source_node", how="left_anti")
    print(f"Already checkpointed (skipped) : {n_already_done} documents")
except Exception:
    print(f"No existing checkpoint table found -- starting fresh at {CHECKPOINT_TABLE}")

n_docs_to_process = doc_prompt_inputs.count()
print(f"Documents to process this run  : {n_docs_to_process}")

if n_docs_to_process == 0:
    print("Nothing to do -- all documents already checkpointed.")
else:
    # ---- Step 3: distributed extraction (mapInPandas -- serverless-safe) --
    # NOTE: .rdd.mapPartitions() is BLOCKED on Databricks serverless compute
    # ([NOT_IMPLEMENTED] "Using custom code using PySpark RDDs is not
    # allowed on serverless compute"). mapInPandas achieves the same
    # distributed-processing goal without touching the RDD API.
    new_triples_df = (
        doc_prompt_inputs
        .repartition(N_PARTITIONS)
        .mapInPandas(process_partition_pandas, schema=TRIPLES_SCHEMA)
    )

    # ---- Step 4: checkpoint immediately (append, don't wait for the end) --
    (new_triples_df.write
        .mode("append")
        .option("mergeSchema", "true")
        .saveAsTable(CHECKPOINT_TABLE))

    n_new = new_triples_df.count()
    print(f"Relationships extracted this run : {n_new}")
    print(f"Checkpointed to                  : {CHECKPOINT_TABLE}")

# ---- Step 5: triples_df = the FULL accumulated result, not just this run --
triples_df = spark.table(CHECKPOINT_TABLE).cache()
n_total = triples_df.count()
print()
print(f"triples_df (all runs combined) row count : {n_total}")
print()
print("Sample triples (source_title --[predicate, strength]--> target_title):")
display(triples_df.select(
    "source_title", "predicate", "relationship_strength",
    "target_title", "relationship_description", "link_type"
))
