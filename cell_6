# Cell 6 : Create One Node per XML  (deterministic + normalized)
# ==========================================================
from pyspark.sql import functions as F
from pyspark.sql import Window

print("=" * 80)
print("KNOWLEDGE NODE CREATION")
print("=" * 80)

# ----------------------------------------------------------
# Input from Cell 5  (clean_docs: doc_id, title, content, reference, source)
# ----------------------------------------------------------
node_df = clean_docs
print(f"XML Documents (clean) : {node_df.count()}")

# ----------------------------------------------------------
# Reference normalization
# MUST be identical to the normalization used in Cell 7
# (hyperlink extraction). If these diverge -> orphan edges.
# ----------------------------------------------------------
def normalize_ref_col(c):
    c = F.trim(c)
    c = F.regexp_replace(c, r"^xwiki:", "")   # strip leading "xwiki:" if present
    c = F.regexp_replace(c, r"\s+", "")        # collapse internal whitespace
    return c

# ----------------------------------------------------------
# Build node projection — requested column set/order
# ----------------------------------------------------------
base = (
    node_df
    .select(
        F.col("doc_id"),
        F.col("source"),
        F.col("reference").alias("node_id"),
        F.col("title").alias("node_name"),
        F.col("content").alias("node_content"),
    )
    .withColumn("node_id", normalize_ref_col(F.col("node_id")))
    .withColumn(
        "content_len",
        F.length(F.coalesce(F.col("node_content"), F.lit("")))
    )
)

# ----------------------------------------------------------
# Deterministic dedup:
# per node_id keep the row with the most content.
# (content_update_date not carried into clean_docs — tie-break
#  falls back to doc_id ascending so it's still deterministic.
#  If two doc_ids ever collide on the same reference, that's
#  itself worth flagging — see diagnostic below.)
# ----------------------------------------------------------
w = (
    Window
    .partitionBy("node_id")
    .orderBy(
        F.col("content_len").desc_nulls_last(),
        F.col("doc_id").asc(),
    )
)

knowledge_nodes = (
    base
    .withColumn("_rk", F.row_number().over(w))
    .filter(F.col("_rk") == 1)
    .drop("_rk")
    .withColumn("has_content", F.col("content_len") > 0)
).cache()

# ----------------------------------------------------------
# Node Statistics
# ----------------------------------------------------------
total_nodes    = knowledge_nodes.count()
n_with_content = knowledge_nodes.filter(F.col("has_content")).count()
n_stub         = total_nodes - n_with_content

# Diagnostic: did any distinct doc_ids collapse onto the same node_id?
n_before_dedup = base.count()
n_collisions   = n_before_dedup - total_nodes

print()
print("=" * 80)
print("KNOWLEDGE NODES")
print("=" * 80)
print(f"Total Nodes Created  : {total_nodes}")
print(f"With Content         : {n_with_content}")
print(f"Stub / Empty         : {n_stub}")
if n_collisions > 0:
    print(f"⚠️  {n_collisions} doc(s) collapsed due to duplicate node_id (reference)")

print()
display(knowledge_nodes.select(
    "doc_id", "source", "node_id", "node_name", "node_content"
))
