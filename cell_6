# Stage 4 : Knowledge Node Creation
# Cell 6 : Create One Node per XML  (deterministic + normalized)
# ==========================================================

from pyspark.sql import functions as F
from pyspark.sql import Window

print("=" * 80)
print("KNOWLEDGE NODE CREATION")
print("=" * 80)

node_df = xml_df
print(f"XML Documents (clean) : {node_df.count()}")

# ----------------------------------------------------------
# Reference Normalizer
# Used on BOTH node_id (here) and on chip targets (edge cell)
# so the two sides can always match. Collapses whitespace,
# never deletes it — deleting breaks matching against chips
# like <doc:Main.Setup Guide> which still contain the space.
# ----------------------------------------------------------

def canonical_ref(c):
    c = F.trim(c)
    c = F.regexp_replace(c, r"^xwiki:", "")
    c = F.regexp_replace(c, r"^wiki:[^:]+:", "")   # strip cross-wiki prefix too
    c = F.regexp_replace(c, r"\s+", " ")           # collapse, don't delete
    c = F.trim(c)
    return c

# ----------------------------------------------------------
# Base table : one row per document, normalized node_id,
# NULL/empty references given a safe synthetic id so no
# document silently disappears into a shared NULL bucket.
# ----------------------------------------------------------

base = (
    node_df
    .select(
        F.col("doc_id"),
        F.col("source"),
        F.col("reference").alias("node_id_raw"),
        F.col("title").alias("node_name"),
        F.col("content_clean").alias("node_content"),
        F.col("content_raw").alias("node_content_raw"),
        F.col("content_update_date"),
    )
    .withColumn("node_id", canonical_ref(F.col("node_id_raw")))
    .withColumn(
        "node_id",
        F.when(
            F.col("node_id").isNull() | (F.length(F.col("node_id")) == 0),
            F.concat(F.lit("__no_ref__doc_"), F.col("doc_id").cast("string"))
        ).otherwise(F.col("node_id"))
    )
    .withColumn("content_len", F.length(F.coalesce(F.col("node_content"), F.lit(""))))
)

n_synth = base.filter(F.col("node_id").startswith("__no_ref__")).count()
if n_synth > 0:
    print(f"⚠️  {n_synth} doc(s) had no reference — synthetic node_id assigned")

# ----------------------------------------------------------
# Deduplicate: one node per node_id.
# Winner = has content > newest update > longest content > lowest doc_id
# (deterministic tiebreak, explicit priority order)
# ----------------------------------------------------------

w = (
    Window.partitionBy("node_id")
    .orderBy(
        (F.col("content_len") > 0).desc(),
        F.col("content_update_date").desc_nulls_last(),
        F.col("content_len").desc(),
        F.col("doc_id").asc()
    )
)

knowledge_nodes = (
    base
    .withColumn("_rk", F.row_number().over(w))
    .filter(F.col("_rk") == 1)
    .drop("_rk")
    .withColumn("has_content", F.col("content_len") > 0)
).cache()

# ----------------------------------------------------------
# Track which documents merged into each surviving node,
# so a collision can be traced back instead of vanishing.
# ----------------------------------------------------------

merge_map = (
    base.groupBy("node_id")
        .agg(
            F.collect_set("doc_id").alias("merged_doc_ids"),
            F.count("*").alias("n_merged")
        )
)

knowledge_nodes = knowledge_nodes.join(merge_map, on="node_id", how="left").cache()

total_nodes    = knowledge_nodes.count()
n_with_content = knowledge_nodes.filter(F.col("has_content")).count()
n_stub         = total_nodes - n_with_content
n_collisions   = base.count() - total_nodes

print()
print("=" * 80)
print("KNOWLEDGE NODES")
print("=" * 80)
print(f"Total Nodes Created  : {total_nodes}")
print(f"With Content         : {n_with_content}")
print(f"Stub / Empty         : {n_stub}")
if n_collisions > 0:
    print(f"⚠️  {n_collisions} doc(s) collapsed due to duplicate node_id (reference)")
    display(knowledge_nodes.filter(F.col("n_merged") > 1)
                            .select("node_id", "node_name", "n_merged", "merged_doc_ids"))

# ----------------------------------------------------------
# Sanity check: node_content MUST equal xml_df's content_clean
# for the same doc_id. Null-safe comparison — plain != would
# silently miss any case where one side is NULL.
# ----------------------------------------------------------

check = (
    knowledge_nodes.alias("n")
    .join(xml_df.select("doc_id", "content_clean").alias("x"), on="doc_id", how="inner")
    .filter(~F.col("n.node_content").eqNullSafe(F.col("x.content_clean")))
)
n_mismatch = check.count()
print(f"\n🔎 node_content vs content_clean mismatch count : {n_mismatch}")
if n_mismatch > 0:
    print("⚠️  MISMATCH DETECTED — rerun Cell 5 fully, then rerun Cell 6.")

print()
display(knowledge_nodes.select("doc_id", "source", "node_id", "node_name", "node_content"))

# ----------------------------------------------------------
# Edge-readiness check: do the <doc:Ref> chips inside content
# actually resolve to a real node_id? This is the number that
# tells you whether the graph will have edges at all.
# ----------------------------------------------------------

chips = (
    knowledge_nodes
    .select("doc_id", F.explode(
        F.expr(r"regexp_extract_all(node_content, '<doc:(?:wiki:)?([^>]+)>', 1)")
    ).alias("target_ref_raw"))
    .withColumn("target_ref", canonical_ref(F.col("target_ref_raw")))
)

total_chips = chips.count()

resolved = (
    chips.join(
        knowledge_nodes.select(F.col("node_id").alias("target_ref")),
        on="target_ref",
        how="inner"
    ).count()
)

print()
print("=" * 80)
print("EDGE-READINESS CHECK (chip -> node resolution)")
print("=" * 80)
print(f"Total link chips found   : {total_chips}")
print(f"Chips resolving to a node: {resolved}")
print(f"Dangling (no matching node): {total_chips - resolved}")

if total_chips > 0:
    print()
    print("Sample dangling references:")
    display(
        chips.join(
            knowledge_nodes.select(F.col("node_id").alias("target_ref")),
            on="target_ref",
            how="left_anti"
        ).distinct().limit(20)
    )

