# ==========================================================
# Cell 8a : Build {reference: title} DICTIONARY from Cell 7's
#           hyperlinks_df, broadcast it for the next cells.
# ==========================================================
import re
from pyspark.sql import functions as F
from pyspark.sql.window import Window

print("=" * 80)
print("CELL 8a — HYPERLINK -> TITLE DICTIONARY")
print("=" * 80)

RAW_TABLE = "knwbt_airr_foundry_dev_catalog.secured.knowbot_raw_data"


def normalize_ref_col(c):
    c = F.trim(c)
    c = F.regexp_replace(c, r"^xwiki:", "")
    c = F.regexp_replace(c, r"\s+", "")
    return c


# distinct targets Cell 7 already found -> only look up titles we need
needed_refs = (
    hyperlinks_df
    .select(normalize_ref_col(F.col("target_reference")).alias("target_reference"))
    .distinct()
)

ver_w = Window.partitionBy("target_reference").orderBy(
    F.col("content_update_date").desc_nulls_last()
)

title_lookup = (
    spark.table(RAW_TABLE)
    .select("reference", "title", "content_update_date")
    .withColumn("target_reference", normalize_ref_col(F.col("reference")))
    .join(needed_refs, on="target_reference", how="inner")
    .withColumn("_rk", F.row_number().over(ver_w))
    .filter(F.col("_rk") == 1)                      # latest version only
    .select("target_reference", F.trim(F.col("title")).alias("title"))
).cache()

# the dictionary — used directly by Cells 8b and 8d (as a UDF closure
# variable). NOT using spark.sparkContext.broadcast() here on purpose:
# shared / Unity-Catalog clusters block direct sparkContext access
# ([JVM_ATTRIBUTE_NOT_SUPPORTED]). A plain dict this size (only the
# targets actually referenced by your docs) serializes to executors
# fine without it.
hyperlink_title_dict = dict(title_lookup.collect())

n_needed   = needed_refs.count()
n_resolved = len(hyperlink_title_dict)

print(f"Distinct link targets (Cell 7)  : {n_needed}")
print(f"Titles resolved into dictionary : {n_resolved}")
print(f"Unresolved targets              : {n_needed - n_resolved}")
print()
display(title_lookup)
