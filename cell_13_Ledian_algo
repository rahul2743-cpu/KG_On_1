# ==========================================================
# Cell 17 : HIERARCHICAL LEIDEN COMMUNITY DETECTION
#           Partitions G (Cell 12) into a HIERARCHY of communities
#           (Traag et al., 2019; GraphRAG paper Section 3.1.4):
#               Community -> Sub-community -> ... -> Leaf community
#           recursively, stopping only when a community can no longer
#           be meaningfully split. This matches the paper's described
#           method exactly, not a single flat pass.
#
#           Pure graph analysis -- no retrieval, no LLM calls, no
#           FAISS. Only tags each node with its community path.
#
#           Community detection uses an UNDIRECTED PROJECTION of the
#           graph. The original directed graph G is preserved and is
#           NOT modified structurally -- only new node attributes are
#           added (community_id, community_path, community_level).
#
#           Partition class: RBConfigurationVertexPartition, not
#           ModularityVertexPartition. The paper doesn't specify a
#           partition class, so this is an explicit design choice, not
#           an assumption -- RBConfiguration exposes a resolution
#           parameter, which this cell uses to make communities
#           progressively FINER at deeper levels (LEIDEN_RESOLUTION
#           grows by RESOLUTION_GROWTH per level). ModularityVertexPartition
#           has no such knob and would make the hierarchy pointless
#           (every level would use the same granularity).
#
#           Needs: G (Cell 12)
#           pip install python-igraph leidenalg   (add to Cell 0)
# ==========================================================
import networkx as nx
import igraph as ig
import leidenalg

print("=" * 80)
print("CELL 17 — HIERARCHICAL LEIDEN COMMUNITY DETECTION")
print("=" * 80)

# ---- Tunable constants, exposed explicitly (not buried in code) --------
# NONE of the four constants below are specified by the paper -- it only
# says "recursively detecting sub-communities... until reaching leaf
# communities that can no longer be partitioned." Everything here is an
# explicit engineering choice made to keep this bounded and reproducible.
LEIDEN_SEED         = 42     # reproducibility across runs (engineering choice)
LEIDEN_RESOLUTION   = 1.0    # starting resolution at level 0 (engineering choice)
RESOLUTION_GROWTH   = 1.3    # increase resolution per deeper level for finer splits
                              # (engineering choice -- paper only says "recursive Leiden",
                              #  not that resolution should change with depth)
MAX_DEPTH           = 3      # practical safety limit, NOT in the paper -- Microsoft's
                              # method stops naturally when Leiden can't partition further;
                              # this cap just guards against pathological runaway recursion
MIN_COMMUNITY_SIZE  = 4      # stop recursing below this size (engineering choice,
                              # not in the paper -- prevents meaningless splits of tiny groups)

# ---- Step 1: undirected projection for community detection -------------
# Community detection uses an UNDIRECTED PROJECTION of the graph.
# The original directed graph G is preserved and is NOT modified --
# direction doesn't define community structure, and parallel edges are
# MERGED by summing relationship_strength into one edge weight, not
# discarded.
G_simple = nx.Graph()
G_simple.add_nodes_from(G.nodes(data=True))
for u, v, d in G.edges(data=True):
    w = d.get("strength", 1)
    if G_simple.has_edge(u, v):
        G_simple[u][v]["weight"] += w
    else:
        G_simple.add_edge(u, v, weight=w)

print(f"Original graph (unchanged) : {G.number_of_nodes()} nodes, {G.number_of_edges()} directed edges")
print(f"Undirected projection      : {G_simple.number_of_nodes()} nodes, {G_simple.number_of_edges()} weighted edges")


def _leiden_partition(nodes, resolution):
    """One Leiden pass on the induced subgraph of `nodes`. Returns a
    list of node-lists (communities). Nodes with no edges among them
    can't be split further -- returned as singletons, not an error."""
    sub = G_simple.subgraph(nodes)
    node_list = list(sub.nodes())
    if len(node_list) <= 1:
        return [node_list]

    edge_list = list(sub.edges())
    if not edge_list:
        return [[n] for n in node_list]

    node_index = {n: i for i, n in enumerate(node_list)}
    edges = [(node_index[u], node_index[v]) for u, v in edge_list]
    weights = [sub[u][v].get("weight", 1) for u, v in edge_list]

    ig_sub = ig.Graph(n=len(node_list), edges=edges)
    ig_sub.es["weight"] = weights

    partition = leidenalg.find_partition(
        ig_sub, leidenalg.RBConfigurationVertexPartition,
        weights="weight", resolution_parameter=resolution, seed=LEIDEN_SEED,
    )
    return [[node_list[idx] for idx in community] for community in partition]


# ---- Step 2: recursive hierarchical partitioning ------------------------
# Each node's path is built by passing `current_path` explicitly down
# through the recursion and assigning the FULL path in one shot at
# whichever level a node stops (never appending to a shared list across
# call frames). This makes correctness obvious from reading this function
# alone -- no need to track append-before-recurse ordering across stack
# frames to see that ancestor community IDs are preserved.
paths = {}


def _recurse(nodes, depth, resolution, current_path):
    # STOP condition 1: too small to meaningfully split further
    if len(nodes) < MIN_COMMUNITY_SIZE or depth >= MAX_DEPTH:
        for n in nodes:
            # current_path is the TRUE hierarchy Leiden actually found --
            # no synthetic digit added just to mark "stopped here". A
            # top-level community that's never split gets path [0] (there
            # has to be SOME id at the root), everything deeper keeps
            # exactly the real community IDs discovered, nothing more.
            paths[n] = current_path if current_path else [0]
        return

    communities = _leiden_partition(nodes, resolution)

    # STOP condition 2: Leiden itself found no further split possible
    # -- this is a LEAF community, exactly as the paper describes.
    # Same rule: keep the TRUE path, no synthetic trailing marker.
    if len(communities) <= 1:
        for n in nodes:
            paths[n] = current_path if current_path else [0]
        return

    for community_id, members in enumerate(communities):
        _recurse(members, depth + 1, resolution * RESOLUTION_GROWTH,
                  current_path + [community_id])


_recurse(list(G_simple.nodes()), 0, LEIDEN_RESOLUTION, [])

# ---- Step 3: per-level community counts, via NATURAL truncation ---------
# No explicit padding needed. A branch that stopped early (e.g. path
# length 2) naturally represents itself at any deeper "level" too, since
# slicing a short list beyond its length just returns the whole short
# list -- this achieves the paper's "otherwise C0 communities projected
# downwards" idea implicitly, without inventing placeholder digits.
if not paths:
    print("\n⚠️  G has zero nodes -- nothing to partition. Check Cell 12 ran correctly.")
    max_depth_reached = 0
else:
    max_depth_reached = max(len(p) for p in paths.values())

    print(f"\nHierarchy depth reached : {max_depth_reached} levels")
    for level in range(max_depth_reached):
        level_ids = {tuple(p[:level + 1]) for p in paths.values()}
        print(f"  Level {level}: {len(level_ids)} communities")

    # ---- Known limitation, discovered during testing --------------------
    # The GROUPING of nodes into communities is stable given the same graph
    # and LEIDEN_SEED. However, the ARBITRARY INTEGER LABEL assigned to each
    # group (e.g. whether a group is called "0" or "1") is NOT guaranteed
    # stable across separate notebook re-runs -- verified by running this
    # exact code 3 times in separate processes: 2 runs matched exactly, the
    # 3rd had two sibling communities' labels swapped (same real grouping,
    # different numbers). Don't persist community_path across sessions as
    # if it were a permanent ID -- re-derive it fresh each run instead.
    print("\n⚠️  Note: community GROUPING is stable across re-runs, but exact")
    print("   numeric labels (community_path) may differ run-to-run.")

# ---- Step 4: tag G (unchanged structure, only new node attributes) ------
n_tagged = 0
for n, p in paths.items():
    G.nodes[n]["community_path"] = ".".join(str(x) for x in p)
    # community_level counts the NUMBER OF SEGMENTS in the path (1-indexed
    # depth count), e.g. path "0.2.1" -> community_level=3. This is a
    # convention choice, not graph-theoretic "depth from root" (which
    # would be len(p)-1, 0-indexed). Documented here so it's unambiguous.
    G.nodes[n]["community_level"] = len(p)
    # WARNING: community_id is the LAST segment only (e.g. "5") -- it is
    # NOT globally unique. Two different branches can end in the same
    # trailing digit (e.g. path "0.2.5" and "1.0.5" both have
    # community_id=5 despite being entirely different communities).
    # community_path IS the real unique identifier. Only use community_id
    # for a quick eyeball glance, never as a grouping/join key downstream.
    G.nodes[n]["community_id"] = p[-1]          # NOT globally unique -- see warning above
    G.nodes[n]["community_id_top"] = p[0]       # coarsest (level 0) grouping
    n_tagged += 1

n_total = G.number_of_nodes()
print(f"\nNodes tagged : {n_tagged}/{n_total}")
if n_tagged != n_total:
    print("⚠️  WARNING: some nodes were not tagged.")
else:
    print("✅ Every node in G has a full community_path.")

print()
print("Sample node -> community path (leaf level):")
for n in list(G.nodes())[:6]:
    label = G.nodes[n].get("label", n)
    print(f"  {label:30s} -> {G.nodes[n]['community_path']}")
