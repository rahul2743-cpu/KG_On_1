# ==========================================================
# Cell 11 : RDF TRIPLE GENERATION
#           Converts triples_df (Cell 10) into an actual RDF graph:
#               Source Entity --[Predicate]--> Target Entity
#           using rdflib. Two things done so NOTHING is lost:
#
#           1. REIFICATION -- a plain RDF triple (s, p, o) has no room
#              to carry relationship_description / relationship_strength
#              / link_type. Standard RDF reification (a blank node
#              describing the statement) is used to attach all of that,
#              alongside the bare triple itself.
#
#           2. FULL DOCUMENT CONTENT -- content_with_titles (Cell 8d)
#              is attached as a literal property on each source entity,
#              so the underlying document text is preserved in the
#              graph too, not just the extracted relationships.
#
#           ENTITY URIs are built from the READABLE TITLE (not the raw
#           GUID-style reference, e.g. NOT
#           "Temp_Import.00257070-2352-11f1-8720-005056902ed8.WebHome").
#           A short hash suffix from the reference is appended ONLY to
#           guarantee two different documents can never collide even if
#           they happen to share the exact same title -- the reference
#           itself is still preserved as a property (ex:sourceReference /
#           ex:targetReference on the reified statement), so nothing is
#           lost, it's just not what the URI is built from anymore.
#
#           Needs: triples_df (Cell 10), document_rendered_df (Cell 8d)
#           pip install rdflib   (add to Cell 0 if not already present)
# ==========================================================
import re
import hashlib
from rdflib import Graph, Namespace, URIRef, Literal, BNode, RDF, RDFS, XSD

print("=" * 80)
print("CELL 11 — RDF TRIPLE GENERATION")
print("=" * 80)

# ---- Namespaces ---------------------------------------------------------
BASE      = "http://knwbt.local/kg/"
ENTITY_NS = Namespace(BASE + "entity/")
PRED_NS   = Namespace(BASE + "predicate/")
EX        = Namespace(BASE + "schema/")   # our own metadata properties


def _slugify(title: str) -> str:
    """Human-readable, e.g. 'TEDS - HOW TO Manage Test Environments'
    -> 'TEDS_HOW_TO_Manage_Test_Environments'."""
    s = re.sub(r"[^\w\s-]", "", title.strip())
    s = re.sub(r"[\s-]+", "_", s)
    return s.strip("_") or "unknown"


def entity_uri(title: str, reference: str) -> URIRef:
    """Readable slug from the TITLE + an 8-char hash of the reference,
    so two entities with the SAME title (rare, but possible) never
    collide into one node. The reference is never lost -- it's still
    stored as ex:sourceReference / ex:targetReference below."""
    short_hash = hashlib.md5(reference.encode()).hexdigest()[:8]
    return URIRef(ENTITY_NS[f"{_slugify(title)}_{short_hash}"])


def predicate_uri(predicate: str) -> URIRef:
    # predicate is already guaranteed snake_case by Cell 10 -> URI-safe as-is
    return URIRef(PRED_NS[predicate])


g = Graph()
g.bind("ex", EX)
g.bind("entity", ENTITY_NS)
g.bind("predicate", PRED_NS)

# ---- Step 1: attach FULL document content to each source entity --------
# One entry per document, independent of how many relationships it has --
# this is where content_with_titles (Cell 8d) gets preserved losslessly.
#
# toLocalIterator() instead of collect(): at 20k documents, .collect()
# would try to materialize EVERY document's full text in driver memory
# simultaneously before processing even starts. toLocalIterator() streams
# rows to the driver one partition at a time -- same end result, far
# lower peak memory. (rdflib.Graph itself is a single-machine, in-memory
# structure with no distributed equivalent, so this is the practical fix
# for Cell 11 -- not a mapPartitions rewrite like Cell 10 needed, since
# there's no LLM/API call here to distribute in the first place.)
n_docs = 0
for d in document_rendered_df.select(
    "source_node", "source_title", "content_with_titles"
).toLocalIterator():
    src_uri = entity_uri(d["source_title"], d["source_node"])
    g.add((src_uri, RDF.type, EX.Document))
    g.add((src_uri, RDFS.label, Literal(d["source_title"])))
    g.add((src_uri, EX.sourceReference, Literal(d["source_node"])))
    g.add((src_uri, EX.documentContent, Literal(d["content_with_titles"])))
    n_docs += 1
    if n_docs % 2000 == 0:
        print(f"  ...{n_docs} documents attached so far")

print(f"Documents with content attached : {n_docs}")

# ---- Step 2: main triples + reified metadata ----------------------------
# Same streaming approach -- and we build the dedup-check SET incrementally
# here instead of re-collecting triple_rows a second time just to count it.
n_rel = 0
seen_main_triples = set()

for t in triples_df.select(
    "source_node", "source_title", "predicate",
    "relationship_description", "relationship_strength",
    "target_title", "target_reference", "link_type"
).toLocalIterator():
    src_uri  = entity_uri(t["source_title"], t["source_node"])
    tgt_uri  = entity_uri(t["target_title"], t["target_reference"])
    pred_uri = predicate_uri(t["predicate"])

    seen_main_triples.add((src_uri, pred_uri, tgt_uri))

    # rdfs:label on both ends, and declare the predicate as an RDF property
    g.add((src_uri, RDFS.label, Literal(t["source_title"])))
    g.add((tgt_uri, RDF.type, EX.Entity))
    g.add((tgt_uri, RDFS.label, Literal(t["target_title"])))
    g.add((tgt_uri, EX.targetReference, Literal(t["target_reference"])))
    g.add((pred_uri, RDF.type, RDF.Property))
    g.add((pred_uri, RDFS.label, Literal(t["predicate"].replace("_", " "))))

    # ---- the actual RDF triple: Source Entity --[Predicate]--> Target Entity
    g.add((src_uri, pred_uri, tgt_uri))

    # ---- reification: describe THIS STATEMENT so no metadata is lost ----
    stmt = BNode()
    g.add((stmt, RDF.type, RDF.Statement))
    g.add((stmt, RDF.subject, src_uri))
    g.add((stmt, RDF.predicate, pred_uri))
    g.add((stmt, RDF.object, tgt_uri))
    g.add((stmt, EX.description, Literal(t["relationship_description"])))
    g.add((stmt, EX.strength, Literal(t["relationship_strength"], datatype=XSD.integer)))
    g.add((stmt, EX.linkType, Literal(t["link_type"])))
    g.add((stmt, EX.sourceReference, Literal(t["source_node"])))
    g.add((stmt, EX.targetReference, Literal(t["target_reference"])))

    n_rel += 1
    if n_rel % 5000 == 0:
        print(f"  ...{n_rel} relationships processed so far")

print(f"Relationships (triples_df rows) : {n_rel}")
print(f"Total RDF triples in graph      : {len(g)}")

# rdflib.Graph is a SET -- if two documents produce the exact same
# (subject, predicate, object), it's stored once, not twice. Duplicate
# hyperlinks across your XML files are expected and handled automatically;
# reified metadata (description/strength) is kept separately per
# relationship regardless, so no provenance is ever lost.
n_actual = len(seen_main_triples)
print(f"Duplicate (source, predicate, target) triples merged : {n_rel - n_actual}")

print()
print("Sample triples (Source Entity --[Predicate]--> Target Entity):")
display(triples_df.select("source_title", "predicate", "target_title", "relationship_strength"))
