# ==========================================================
# Cell 8 : Ontology Discovery — LLM reads REAL document content
# from Cell 6's `knowledge_nodes`. Fully generic — works whether
# you loaded 50 or 500+ docs. Entity/relation categories emerge
# from evidence across a sample; count is NOT preset.
# ==========================================================
from pyspark.sql import functions as F
import json

print("=" * 80)
print("CONTENT-BASED ONTOLOGY DISCOVERY")
print("=" * 80)

total_docs = knowledge_nodes.count()
print(f"Total documents available : {total_docs}")

# ----------------------------------------------------------
# 1. Sample size scales with corpus size — enough to see real
#    repetition, not so much that cost balloons at 100-500+ docs.
#    Skip empty/stub documents (same fix as the doc_id=40 case).
# ----------------------------------------------------------
MIN_CONTENT_LENGTH = 200
SAMPLE_SIZE = min(30, total_docs)   # cap at 30 regardless of corpus size — cheap, still solid evidence

eligible_docs = knowledge_nodes.filter(
    F.length(F.coalesce(F.col("node_content"), F.lit(""))) >= MIN_CONTENT_LENGTH
)

n_eligible = eligible_docs.count()
print(f"Documents with real content (≥{MIN_CONTENT_LENGTH} chars) : {n_eligible}")

sample_docs = (
    eligible_docs
    .select("doc_id", "node_name", "node_content")
    .orderBy(F.rand(seed=42))          # random across the WHOLE corpus, not first-N
    .limit(SAMPLE_SIZE)
    .collect()
)

print(f"Sampling {len(sample_docs)} documents for ontology discovery\n")

# ----------------------------------------------------------
# 2. Ask the LLM, per sampled document, what KINDS of entities
#    and relationships actually appear — generic prompt, no
#    domain assumptions baked in.
# ----------------------------------------------------------
DISCOVERY_PROMPT = """Read this document. Identify:

1. DISTINCT KINDS of named things it mentions (categories, not the
   specific names) — e.g. "named product/component", "named test
   procedure", "named standard/regulation".

2. DISTINCT KINDS of relationships between those things, AS ACTUALLY
   EXPRESSED in the text — e.g. "X is part of Y", "X is governed by Y",
   "X identifies Y". Describe the relationship TYPE generically.

Be specific to what THIS text actually contains. Do not guess
categories that aren't evidenced here. Return at most 5 of each.

Respond as JSON only, no other text:
{{"entity_categories": ["...", "..."], "relation_categories": ["...", "..."]}}

Document title: {title}
Document text:
{content}
"""

entity_votes = {}
relation_votes = {}
failures = 0

for i, row in enumerate(sample_docs, 1):
    prompt = DISCOVERY_PROMPT.format(
        title=row["node_name"] or "",
        content=(row["node_content"] or "")[:3000],
    )
    try:
        response = llm.invoke([("human", prompt)])
        text = response.content.strip().replace("```json", "").replace("```", "").strip()
        parsed = json.loads(text)

        for cat in parsed.get("entity_categories", []):
            key = cat.strip().lower()
            if key:
                entity_votes[key] = entity_votes.get(key, 0) + 1

        for cat in parsed.get("relation_categories", []):
            key = cat.strip().lower()
            if key:
                relation_votes[key] = relation_votes.get(key, 0) + 1

    except Exception as e:
        failures += 1
        print(f"  [{i}/{len(sample_docs)}] ⚠️  Failed on '{row['node_name']}': {e}")

n_ok = len(sample_docs) - failures
print(f"\n{n_ok}/{len(sample_docs)} documents processed successfully")

# ----------------------------------------------------------
# 3. Report — categories multiple INDEPENDENT documents
#    surfaced are the real signal. Threshold scales loosely
#    with sample size (not hardcoded to one corpus size).
# ----------------------------------------------------------
REPEAT_THRESHOLD = max(2, round(n_ok * 0.15))   # e.g. ~15% of successful docs, min 2

print()
print("=" * 80)
print(f"ENTITY CATEGORY VOTES  (repeat threshold: ≥{REPEAT_THRESHOLD} docs)")
print("=" * 80)
for cat, n in sorted(entity_votes.items(), key=lambda x: -x[1]):
    flag = "✅ repeated" if n >= REPEAT_THRESHOLD else "⚠️  one-off"
    print(f"  {n:2d}  {cat:50s} {flag}")

print()
print("=" * 80)
print(f"RELATION CATEGORY VOTES  (repeat threshold: ≥{REPEAT_THRESHOLD} docs)")
print("=" * 80)
for cat, n in sorted(relation_votes.items(), key=lambda x: -x[1]):
    flag = "✅ repeated" if n >= REPEAT_THRESHOLD else "⚠️  one-off"
    print(f"  {n:2d}  {cat:50s} {flag}")

# ----------------------------------------------------------
# Summary
# ----------------------------------------------------------
n_confirmed_entities  = sum(1 for n in entity_votes.values() if n >= REPEAT_THRESHOLD)
n_confirmed_relations = sum(1 for n in relation_votes.values() if n >= REPEAT_THRESHOLD)

print()
print("=" * 80)
print("NEXT STEP")
print("=" * 80)
print(f"{n_confirmed_entities} entity categories and {n_confirmed_relations} relation")
print("categories crossed the repeat threshold. Review the ✅ rows above, merge")
print("any near-duplicate phrasings, and lock them as ENTITY_TYPES/RELATION_TYPES")
print("in Cell 9 (Pydantic schema). Count is whatever the evidence supports —")
print("not chosen in advance.")
