# ══════════════════════════════════════════════════════════
# STEP 5 — FULL DOCUMENT rendering (not per-sentence)
#          Every <doc:...> link in the WHOLE document gets replaced
#          with its resolved title, Wikipedia-blue-hyperlink style.
#
#   100% generic — works on ANY document, ANY number of links.
#   Reuses the exact same LINK_RE and _dict_bc built above.
#   NOTHING is hardcoded: title = _dict_bc.value.get(reference),
#   same dictionary Step 1 built from Cell 7's own hyperlinks_df.
#   Unresolved links are flagged in red, never guessed.
# ══════════════════════════════════════════════════════════

def _norm_py(ref):
    r = ref.strip()
    r = re.sub(r"^xwiki:", "", r)
    r = re.sub(r"\s+", "", r)
    return r


def render_plain(text):
    """Full document, every link -> <Resolved Title>. Generic replace."""
    if not text:
        return text
    lookup = _dict_bc.value

    def repl(m):
        ref = _norm_py(m.group("ref"))
        title = lookup.get(ref)
        return f"<{title}>" if title else f"[UNRESOLVED:{ref}]"

    out = LINK_RE.sub(repl, text)
    out = re.sub(r"[ \t]*\n[ \t]*", " ", out)   # collapse hard line-wraps
    out = re.sub(r"\s+", " ", out).strip()
    return out


def render_html(text):
    """Full document as HTML — every link -> a blue hyperlink span,
    Wikipedia style. Generic: title text comes only from the
    dictionary, nothing about any specific document is hardcoded."""
    if not text:
        return text
    lookup = _dict_bc.value

    def repl(m):
        ref = _norm_py(m.group("ref"))
        title = lookup.get(ref)
        if title:
            safe = title.replace("&", "&amp;").replace('"', "&quot;")
            return (f'<a href="#{ref}" '
                    f'style="color:#0645ad;text-decoration:none">{safe}</a>')
        return f'<span style="color:#cc0000">[UNRESOLVED:{ref}]</span>'

    out = LINK_RE.sub(repl, text)
    out = re.sub(r"[ \t]*\n[ \t]*", " ", out)
    out = re.sub(r"\s+", " ", out).strip()
    return f'<p style="font-family:Georgia,serif;line-height:1.7">{out}</p>'


render_plain_udf = F.udf(render_plain, StringType())
render_html_udf  = F.udf(render_html,  StringType())

