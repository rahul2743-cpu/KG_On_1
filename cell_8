# ==========================================================
# Stage 6 : Hyperlink -> Title Resolution & Sentence Context
# Cell 8 : Build a {reference: title} DICTIONARY straight from
#          Cell 7's hyperlinks_df, then use it to replace every
#          <doc:...> / <doc:wiki:...> occurrence inside the
#          content with the real document TITLE.
#
#   Cell 7 already found every hyperlink (source, target_reference,
#   link_type). Cell 8 does NOT re-discover links with a new regex —
#   it reuses Cell 7's own pattern pieces, so the two cells can never
#   disagree on what counts as a link. It only adds:
#     1. the real TITLE for each target_reference (dictionary lookup)
#     2. the SENTENCE each link occurrence sits in (needed for the
#        LLM predicate step in Cell 9)
# ==========================================================
import re
from pyspark.sql import functions as F
from pyspark.sql.window import Window
from pyspark.sql.types import (
    ArrayType, StructType, StructField, StringType, IntegerType
)

print("=" * 80)
print("HYPERLINK -> TITLE DICTIONARY  +  SENTENCE CONTEXT  (Cell 8)")
print("=" * 80)

RAW_TABLE   = "knwbt_airr_foundry_dev_catalog.secured.knowbot_raw_data"
MARKER      = "@@LINK@@"                 # internal-only, never shown to the user/LLM
PLACEHOLDER = "<System Of Interest>"      # fixed masking label — a constant BY DESIGN
                                           # (per your pipeline diagram), not a data value.
                                           # It never comes from a table because it isn't
                                           # describing a document — it marks "a link was
                                           # masked here". Change this ONE line to relabel
                                           # it everywhere; it is never hardcoded elsewhere.
MAX_SENT    = 600                         # hard cap on a "sentence" (guards huge bullet/table rows)


def normalize_ref_col(c):
    c = F.trim(c)
    c = F.regexp_replace(c, r"^xwiki:", "")
    c = F.regexp_replace(c, r"\s+", "")
    return c


# ══════════════════════════════════════════════════════════
# STEP 1 — Build the {reference: title} dictionary
#          FROM Cell 7's hyperlinks_df (your idea)
#
#   distinct target_reference values Cell 7 already found
#   -> joined (only those) against the raw table
#   -> collected into one small python dict
#   -> broadcast to every executor
#
#   This is smaller and faster than scanning the whole raw table
#   for titles no link ever points to.
# ══════════════════════════════════════════════════════════
needed_refs = (
    hyperlinks_df
    .select(normalize_ref_col(F.col("target_reference")).alias("target_reference"))
    .distinct()
)

ver_w = Window.partitionBy("target_reference").orderBy(
    F.col("content_update_date").desc_nulls_last()
)

title_lookup = (
    spark.table(RAW_TABLE)
    .select("reference", "title", "content_update_date")
    .withColumn("target_reference", normalize_ref_col(F.col("reference")))
    .join(needed_refs, on="target_reference", how="inner")   # only refs Cell 7 actually uses
    .withColumn("_rk", F.row_number().over(ver_w))
    .filter(F.col("_rk") == 1)                                 # latest version only
    .select("target_reference", F.trim(F.col("title")).alias("title"))
)

# --- the dictionary itself ---
hyperlink_title_dict = dict(title_lookup.collect())
_dict_bc = spark.sparkContext.broadcast(hyperlink_title_dict)

print(f"Distinct link targets (Cell 7) : {needed_refs.count()}")
print(f"Titles resolved into dictionary : {len(hyperlink_title_dict)}")
print(f"Unresolved targets              : {needed_refs.count() - len(hyperlink_title_dict)}")


# ══════════════════════════════════════════════════════════
# STEP 2 — SAME link pattern as Cell 7 (no second/rewritten regex)
#          Cell 7's pieces, re-assembled with named groups so we
#          can also capture the character offset per occurrence.
# ══════════════════════════════════════════════════════════
LINK_RE = re.compile(
    r"\[(?:(?P<label>[^<>\[\]]+?)\s+)?<doc:(?P<wiki>wiki:)?(?P<ref>[^>]+)>\]"
)

# ---- drift guard --------------------------------------------------
# Cell 7 defines FULL_MATCH and stays in the notebook's global scope.
# If Cell 7's pattern is ever edited, this fails loudly instead of
# Cell 8 silently extracting a different set of links than Cell 7 did.
try:
    _EXPECTED_FULL_MATCH = r"\[(?:[^<>\[\]]+?\s+)?<doc:(?:wiki:)?[^>]+>\]"
    assert FULL_MATCH == _EXPECTED_FULL_MATCH, (
        "Cell 7's FULL_MATCH has changed — Cell 8's LINK_RE must be "
        "updated to match it, or the two cells will find different links."
    )
    print("✅ Cell 8's link pattern still matches Cell 7's FULL_MATCH")
except NameError:
    print("⚠️  Cell 7 (FULL_MATCH) not found in scope — run Cell 7 before Cell 8.")

# A single \n is a LINE-WRAP, not a sentence end (your source text is
# hard-wrapped at ~100 chars). Only real punctuation or a blank line
# (paragraph break) ends a sentence.
_LEFT_STOP  = re.compile(r"[.!?;:]|\n\s*\n")
_RIGHT_STOP = re.compile(r"[.!?;]|\n\s*\n")

LINK_SCHEMA = ArrayType(StructType([
    StructField("occurrence",       IntegerType()),
    StructField("display_text",     StringType()),
    StructField("link_type",        StringType()),
    StructField("target_reference", StringType()),
    StructField("sentence_marked",  StringType()),
]))


def _sentence_bounds(text, s, e, spans):
    """
    `spans` = every link's (start, end) found in this document. Reference
    ids often contain a literal '.' (e.g. Temp_Import.ed9bcae1-...WebHome) —
    a stop character that falls INSIDE another link's span must be ignored,
    or the boundary search slices a neighboring link in half.
    """
    def inside_any(pos):
        return any(sp <= pos < ep for sp, ep in spans)

    lo = max(0, s - MAX_SENT)
    search_pos, last_stop = lo, None
    while True:
        m = _LEFT_STOP.search(text, search_pos, s)
        if not m:
            break
        if not inside_any(m.start()):
            last_stop = m
        search_pos = m.end()
    start = last_stop.end() if last_stop else lo

    hi = min(len(text), e + MAX_SENT)
    search_pos, end = e, hi
    while True:
        m = _RIGHT_STOP.search(text, search_pos, hi)
        if not m:
            break
        if not inside_any(m.start()):
            end = m.end()
            break
        search_pos = m.end()
    return start, end


def extract_and_replace(text):
    """
    Walk every link occurrence in `text`. For each occurrence, build
    its sentence with:
      - THIS link      -> MARKER   (swapped to <System Of Interest> in Spark)
      - other links in the SAME sentence -> resolved <Title> from the
        broadcast dictionary (built in Step 1), or [UNRESOLVED:ref] if
        that target isn't in the dictionary. Never a guessed name.
    """
    if not text:
        return []

    matches = list(LINK_RE.finditer(text))
    if not matches:
        return []

    spans  = [m.span() for m in matches]
    lookup = _dict_bc.value

    def norm(ref):
        r = ref.strip()
        r = re.sub(r"^xwiki:", "", r)
        r = re.sub(r"\s+", "", r)
        return r

    parsed = [{
        "span":  m.span(),
        "label": (m.group("label") or "").strip(),
        "ref":   m.group("ref").strip(),
        "wiki":  bool(m.group("wiki")),
        "title": lookup.get(norm(m.group("ref"))),
    } for m in matches]

    rows = []
    for i, p in enumerate(parsed):
        s, e = p["span"]
        start, end = _sentence_bounds(text, s, e, spans)

        pieces, cursor = [], start
        for j, q in enumerate(parsed):
            qs, qe = q["span"]
            if qs < start or qe > end:
                continue
            pieces.append(text[cursor:qs])
            if j == i:
                pieces.append(MARKER)
            elif q["title"]:
                pieces.append(f"<{q['title']}>")
            else:
                pieces.append(f"[UNRESOLVED:{q['ref']}]")
            cursor = qe
        pieces.append(text[cursor:end])

        sent = re.sub(r"\s+", " ", "".join(pieces)).strip()

        rows.append((
            i,
            p["label"],
            "doc:wiki" if p["wiki"] else "doc:Temp_Import",
            p["ref"],
            sent,
        ))
    return rows


extract_udf = F.udf(extract_and_replace, LINK_SCHEMA)


# ══════════════════════════════════════════════════════════
# STEP 3 — Explode to one row per link OCCURRENCE, resolve THIS
#          row's own title via the same dictionary (Spark-side join,
#          equivalent lookup, keeps everything consistent).
# ══════════════════════════════════════════════════════════
links_with_context = (
    knowledge_nodes
    .select("source", "node_id", "node_name", "node_content")
    .withColumn("_l", F.explode(extract_udf(F.col("node_content"))))
    .select(
        F.col("source"),
        F.col("node_id").alias("source_node"),
        F.col("node_name").alias("source_title"),           # SOURCE ENTITY
        F.col("_l.occurrence").alias("occurrence"),
        F.col("_l.display_text").alias("display_text"),
        F.col("_l.link_type").alias("link_type"),
        normalize_ref_col(F.col("_l.target_reference")).alias("target_reference"),
        F.col("_l.sentence_marked").alias("sentence_marked"),
    )
).cache()

