    for et in ontology_proposal["entity_types"]:
        print(f"\n  {et['name']}")
        print(f"    evidence: {et['evidence']}")
    print()
    for rt in ontology_proposal["relation_types"]:
        print(f"  {rt['name']:22s} — {rt['description']}")

except Exception as e:
