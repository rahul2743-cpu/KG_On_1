# ----------------------------------------------------------
# Join hub_docs (raw UUID references) against the title lookup
# so we can actually SEE what the top concepts are, not just IDs.
# ----------------------------------------------------------
hub_docs_titled = (
    hub_docs
    .join(
        knowledge_nodes.select(
            F.col("node_id").alias("target_reference"),
            F.col("node_name").alias("target_title"),
        ),
        on="target_reference",
        how="left",
    )
    .orderBy(F.desc("inbound_links"))
)

print("Top hub documents, with titles:")
display(hub_docs_titled.limit(20))

n_unresolved = hub_docs_titled.filter(F.col("target_title").isNull()).count()
print(f"\n⚠️  {n_unresolved} of the top hub references have no title in the loaded "
